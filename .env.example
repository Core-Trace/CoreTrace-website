# Ambiente
AMBIENTE_PROCESSO=desenvolvimento

# Banco de dados MySQL
DB_HOST=localhost
DB_DATABASE=coretrace
DB_USER=root
DB_PASSWORD=senha_exemplo
DB_PORT=3306

# Servidor da aplicação
APP_HOST=localhost
APP_PORT=3333

# Endereço usado no link de ativação enviado por email
# Para acesso em outro dispositivo, use uma URL acessível ao destinatário.
APP_URL=http://localhost:3333

# Chave de API do Resend (valor fictício; substitua pela sua chave)
RESEND_API_KEY=re_sua_chave_do_resend

# O remetente de teste envia apenas ao email da sua conta Resend.
# Para outros destinatários, use um remetente de domínio verificado.
RESEND_FROM=onboarding@resend.dev
